#include <winver.h>

1 24 "hayate.manifest"

// lowest icon ID = the exe's icon (Explorer, taskbar, Alt-Tab, shortcuts);
// from assets/brand (build.py)
1 ICON "hayate.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,1,0
PRODUCTVERSION  0,2,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Hayate Project"
            VALUE "FileDescription",  "Hayate Task Manager"
            VALUE "FileVersion",      "0.2.1.0"
            VALUE "InternalName",     "hayate"
            VALUE "LegalCopyright",   "Personal build"
            VALUE "OriginalFilename", "hayate.exe"
            VALUE "ProductName",      "Hayate"
            VALUE "ProductVersion",   "0.2.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
